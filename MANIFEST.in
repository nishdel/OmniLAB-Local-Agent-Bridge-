include README.md LICENSE pyproject.toml requirements.lock.txt config.example.toml
include CHANGELOG.md CONTRIBUTING.md AGENTS.md SECURITY.md CODEX_POLICY.md
include PUBLIC-FILES.txt
include *.md .gitignore
recursive-include .github *.md *.yml
recursive-include localagentbridge *.py *.toml
recursive-include localagentbridge/executor_assets Dockerfile *.txt
recursive-include docs *.md *.json *.png
recursive-include docs/qualification *.patch *.txt
recursive-include examples *.toml *.json
recursive-include profiles *.toml
recursive-include tests *.py *.json
recursive-include scripts *.py
include website/package.json website/package-lock.json website/build.mjs
recursive-include website/assets *.css *.js
prune data
prune benchmarks
prune release-staging
prune docs/model-evaluations
global-exclude __pycache__ *.pyc *.sqlite* *.log *.jsonl
